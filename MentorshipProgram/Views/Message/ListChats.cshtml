@using MentorshipProgram.DTOs
@model ListChatsViewModel
@{
    ViewData["title"] = "My Chats";

    // string receiver;

}



<div class="container-fluid">
    <h1 class="my-4">@ViewBag.Title</h1>

    <!-- Full‑width Chats bar -->
    <div class="card mb-4">
        <div class="card-header bg-warning">
            <ul class="nav nav-pills flex-row">
                @if(Model is not null && Model.Messages is not null) {
                    @foreach (var message in Model.Messages)
                    {
                        <li class="nav-item" style="border-right:20px">

                            <a class="nav-link" href="@Url.Action("Index", "Message", new { ChatId =  message.ChatId})">
                                @* <img src="@chat.AvatarUrl" *@
                                @*      class="rounded-circle" *@
                                @*      style="width:30px; height:30px; margin-right:5px;" /> *@
                                @message.SenderEmail
                                @message.Body
                            </a>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>

    <div class="card-footer">
        @using (Html.BeginForm("SendMessageNewChat", "Message", FormMethod.Post, new { @class = "d-flex align-items-start g-2" }))
        {
            @* Hidden fields for chat metadata *@
            @* @Html.HiddenFor(m => m.SendMessage.Id) *@
            @* @Html.HiddenFor(m => m.Chat.Participant1Email) *@
            @* @Html.HiddenFor(m => m.Chat.Participant2Email) *@
            @Html.HiddenFor(m => m.Messages, new List<MessageModel>());

            @* Receiver email input *@
            <div class="flex-shrink-0 me-2" style="width: 200px;">
                @Html.TextBoxFor(
                         m => m.SendMessage.ReceiverEmail,
                         new
                         {
                             @class = "form-control",
                             placeholder = "Receiver email",
                             autocomplete = "off"
                         })
            </div>

            @* Text input for the message body *@
            <div class="flex-grow-1 me-2">
                @Html.TextBoxFor(
                         m => m.SendMessage.Body,
                         new
                         {
                             @class = "form-control",
                             placeholder = "Type your message…",
                             autocomplete = "off"
                         })
            </div>

            <button type="submit" class="btn btn-primary">
                Send
            </button>
        }
    </div>

</div>