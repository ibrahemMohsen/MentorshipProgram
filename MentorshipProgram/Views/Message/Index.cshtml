@model IEnumerable<MessageModel>
@{
    Layout = null; // or your site layout
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Chat Menu</title>
    <!-- Bootswatch Cosmo theme -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.0/dist/cosmo/bootstrap.min.css" />
</head>
<body>
    <div class="container mt-4">
        <h4>Your Chats</h4>
        <ul class="list-group">
            @foreach (var chat in Model)
            {
                <li class="list-group-item d-flex justify-content-between align-items-start">
                    <div class="ms-2 me-auto">
                        <div class="fw-bold">@chat.SenderEmail</div>
                        @* <small class="text-muted">@chat.LastMessageBody</small> *@
                    </div>
                    @* <span class="badge bg-primary rounded-pill">@chat.TimeSent.ToString("g")</span> *@
                </li>
            }
        </ul>
    </div>
</body>
</html>
