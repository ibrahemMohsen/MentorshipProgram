@model ChatModel 
@{
    Layout = null; // or your site layout
}
<div class="container mt-4">
    <h4>Your Chats</h4>
    <ul class="list-group">
        
        @foreach (MessageModel? chat in Model.Messages)
        {
            <li class="list-group-item d-flex justify-content-between align-items-start">
                <div class="ms-2 me-auto">
                    <div class="fw-bold">@chat.SenderEmail</div>
                    <div class="fw-bold">@chat.ReceiverEmail</div>
                    <div class="fw-bold">@chat.Body</div>
                    <div class="fw-bold">@chat.TimeSent</div>
                    @* <small class="text-muted">@chat.LastMessageBody</small> *@
                </div>
                @* <span class="badge bg-primary rounded-pill">@chat.TimeSent.ToString("g")</span> *@
            </li>
        }
    </ul>
</div>