@using MentorshipProgram.Data
@model IEnumerable<UserDetailsModel>
@{
    ViewData["Title"] = "Image Gallery";
}

<h2>@ViewData["Title"]</h2>

<table class="table">
    <thead>
        <tr>
            <th>Preview</th>
            <th>File Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <img src="@Url.Action("Details", "ImageFiles", new { UserName = item.UserName })"
                         alt="@item.FileName"
                         style="max-height:100px;" />
                </td>
                <td>@item.FileName</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.UserName">View</a> |
                    <a asp-action="Edit" asp-route-id="@item.UserName">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.UserName">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
