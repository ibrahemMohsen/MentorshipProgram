@using MentorshipProgram.DTOs;
@model SignInViewModel
@{
	ViewData["Title"] = "Sign In Page";
}

<form method="post">
	<div class="border p-3 mt-4">
		<div class="row pb-2">
			<h2 class="text-primary">Sign In</h2>
			<hr />
		</div>
		<div class="mb-3">
			<label asp-for="UserName">User Name</label>
			<input asp-for="UserName" class="form-control" />
			<span asp-validation-for="UserName" class="text-danger"></span>
		</div>
		<div class="mb-3">
			<label asp-for="Password">Password</label>
			<input type="password" asp-for="Password" class="form-control" />
			<span asp-validation-for="Password" class="text-danger"></span>
		</div>

		<button type="submit" class="btn btn-primary" style="width:150px">Sign In</button>
		<a asp-controller="User" asp-action="SignIn" class="btn btn-secondary" style="width:150px">
			Back To List
		</a>
	</div>
</form>
