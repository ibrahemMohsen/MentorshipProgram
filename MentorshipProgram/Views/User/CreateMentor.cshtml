@using MentorshipProgram.DTOs
@model CreateMentorViewModel

<form method="post">
	<div class="border p-3 mt-4">
		<div class="row pb-2">
			<h2 class="text-primary">Create Mentor</h2>
			<hr />
		</div>
		<div class="mb-3">
			<label asp-for="Name">Name</label>
			<input asp-for="Name" class="form-control" />
			<span asp-validation-for="Name" class="text-danger"></span>
		</div>
		<div class="mb-3">
			<label asp-for="UserName">User Name</label>
			<input asp-for="UserName" class="form-control" />
			<span asp-validation-for="UserName" class="text-danger"></span>
		</div>
		<div class="mb-3">
			<label asp-for="Password">Password</label>
			<input type="password" asp-for="Password" class="form-control" />
			<span asp-validation-for="Password" class="text-danger"></span>
		</div>
		<div class="mb-3">
			<label asp-for="Field">Field</label>
			<input asp-for="Field" class="form-control" />
			<span asp-validation-for="Field" class="text-danger"></span>
		</div>
		<div class="mb-3">
			<label asp-for="YearsOfExperience">Years of Experience</label>
			<input asp-for="YearsOfExperience" class="form-control" />
			<span asp-validation-for="YearsOfExperience" class="text-danger"></span>
		</div>
		<button type="submit" class="btn btn-primary" style="width:150px">Create</button>
		<a asp-controller="User" asp-action="CreateMentor" class="btn btn-secondary" style="width:150px">
			Back To List
		</a>
	</div>
</form>
