@model IEnumerable<Category>?
@{
    ViewData["Title"] = "Index";
}
<h1>Index Category</h1>
<table class="table table-bordered table-striped" width="100%">
    <thead>
        <tr>
            <th>
                Category Name
            </th>

            <th>
                Display Order
            </th>

            <th>
                Datetime
            </th>

            <th>
                ID
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach(var obj in Model)
        {
            <tr>
                <td width="25%">
                    @obj.Name
                </td>
                <td width="25%">
                    @obj.DisplayOrder
                </td>
                <td width="25%">
                    @obj.CreatedDateTime
                </td>
                <td width="25%">
                    @obj.Id
                </td>
            </tr>
        }
    </tbody>
</table>